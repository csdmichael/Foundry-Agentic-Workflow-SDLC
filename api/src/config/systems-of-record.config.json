      "allowedProviders": ["azure-devops", "github-issues"],
      "requiresProject": true,
      "urlHint": "https://dev.azure.com/{orgName}"
    },
    {
      "key": "testManagement",
      "label": "Test Cases & Test Plans Tracking",
      "description": "Where test plans, suites, and cases are managed.",
      "allowedProviders": ["azure-devops", "github-issues"],
      "requiresProject": true,
      "urlHint": "https://dev.azure.com/{orgName}"
    },
    {
      "key": "buildPipelines",
      "label": "Code Build / Pipelines",
