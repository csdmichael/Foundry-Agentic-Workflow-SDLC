      "allowedProviders": ["azure-devops", "github-actions"],
      "requiresProject": true,
      "urlHint": "https://dev.azure.com/{orgName} or https://github.com/{orgName}"
    },
    {
      "key": "sourceCodeOrg",
      "label": "Source Code Org",
      "description": "Organization that owns the generated repositories.",
      "allowedProviders": ["github", "azure-repos"],
      "requiresProject": false,
      "urlHint": "https://github.com/{orgName}"
    }
  ],
