{
  "$comment": "System of Record defaults (non-secret). 'catalog' drives UI rendering and server-side provider validation; 'defaults' seeds the global settings that every project inherits unless it overrides them.",
  "catalog": [
    {
      "key": "documentation",
      "label": "Documentation",
      "description": "Where approved requirements, architecture, and design artifacts are published.",
