      "mcpServersAllowed": ["azure-devops-mcp"],
      "maxInputTokens": 24000,
      "maxOutputTokens": 8000,
      "temperature": 0.2,
      "requiresHumanApproval": true,
      "approvalRole": "admin",
      "guardrails": ["gp-content-safety"],
      "enabled": true
    },
    {
      "agentId": "devops-release-agent",
      "displayName": "DevOps / Release Agent",
      "lifecycleStage": "deploy",
      "modelDeploymentName": "gpt-4o",
      "modelProvider": "azure-openai",
      "apimRoute": "foundry/chat/completions",
      "toolsAllowed": ["pipeline-write", "azure-provision"],
      "mcpServersAllowed": [],
      "maxInputTokens": 24000,
      "maxOutputTokens": 8000,
      "temperature": 0.1,
      "requiresHumanApproval": true,
      "approvalRole": "it_user",
      "guardrails": ["gp-content-safety", "gp-secret-scan"],
      "enabled": true
    },
    {
      "agentId": "security-compliance-agent",
      "displayName": "Security and Compliance Agent",
      "lifecycleStage": "security",
      "modelDeploymentName": "gpt-4o",
      "modelProvider": "azure-openai",
      "apimRoute": "foundry/chat/completions",
      "toolsAllowed": ["knowledge-search", "github-repo", "azure-provision"],
      "mcpServersAllowed": [],
      "maxInputTokens": 32000,
      "maxOutputTokens": 8000,
      "temperature": 0.0,
      "requiresHumanApproval": true,
      "approvalRole": "admin",
      "guardrails": ["gp-content-safety", "gp-secret-scan"],
      "enabled": true
