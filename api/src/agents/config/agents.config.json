{
  "$comment": "Agent orchestration tier configuration. One entry per specialized Foundry agent. Models/routes are configurable; no secrets here.",
  "defaults": {
    "modelProvider": "azure-openai",
    "maxInputTokens": 16000,
    "maxOutputTokens": 4000,
    "temperature": 0.2
  },
  "agents": [
    {
      "agentId": "requirements-agent",
      "displayName": "Requirements Agent",
      "lifecycleStage": "plan",
      "modelDeploymentName": "gpt-4o",
      "modelProvider": "azure-openai",
      "apimRoute": "foundry/chat/completions",
      "toolsAllowed": ["sharepoint-read", "onedrive-read", "local-upload-read", "ado-workitems"],
      "mcpServersAllowed": ["azure-devops-mcp"],
      "maxInputTokens": 24000,
      "maxOutputTokens": 6000,
      "temperature": 0.2,
      "requiresHumanApproval": true,
      "approvalRole": "business_user",
      "guardrails": ["gp-content-safety", "gp-pii-redaction"],
      "enabled": true
    },
    {
      "agentId": "architecture-advisor-agent",
      "displayName": "Architecture Advisor Agent",
      "lifecycleStage": "design",
      "modelDeploymentName": "gpt-4o",
      "modelProvider": "azure-openai",
      "apimRoute": "foundry/chat/completions",
      "toolsAllowed": ["sharepoint-write", "knowledge-search"],
      "mcpServersAllowed": [],
      "maxInputTokens": 24000,
      "maxOutputTokens": 8000,
      "temperature": 0.3,
      "requiresHumanApproval": true,
      "approvalRole": "it_user",
      "guardrails": ["gp-content-safety"],
      "enabled": true
    },
    {
      "agentId": "code-generation-agent",
      "displayName": "Code Generation Agent",
      "lifecycleStage": "build",
      "modelDeploymentName": "gpt-4o",
      "modelProvider": "azure-openai",
      "apimRoute": "foundry/chat/completions",
      "toolsAllowed": ["github-repo", "github-pr"],
      "mcpServersAllowed": ["github-mcp"],
      "maxInputTokens": 32000,
      "maxOutputTokens": 12000,
      "temperature": 0.1,
      "requiresHumanApproval": true,
      "approvalRole": "it_user",
      "guardrails": ["gp-content-safety", "gp-secret-scan"],
      "enabled": true
    },
    {
      "agentId": "test-automation-agent",
      "displayName": "Test Automation Agent",
      "lifecycleStage": "test",
      "modelDeploymentName": "gpt-4o",
      "modelProvider": "azure-openai",
