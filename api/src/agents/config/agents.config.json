    {
      "agentId": "knowledge-assistant",
      "displayName": "Knowledge Assistant",
      "lifecycleStage": "operate",
      "modelDeploymentName": "gpt-4o",
      "modelProvider": "azure-openai",
      "apimRoute": "foundry/chat/completions",
      "toolsAllowed": ["knowledge-search", "sharepoint-read", "onedrive-read"],
      "mcpServersAllowed": [],
      "maxInputTokens": 32000,
      "maxOutputTokens": 6000,
      "temperature": 0.3,
      "requiresHumanApproval": false,
      "approvalRole": "business_user",
      "guardrails": ["gp-content-safety"],
      "enabled": true
