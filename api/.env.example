# -----------------------------------------------------------------------------
# Agentic SDLC API — environment variables (SAMPLE / NON-SECRET placeholders)
# Copy to `.env` for local development. NEVER commit real secrets.
# In Azure, set these as App Service application settings or Key Vault refs.
# -----------------------------------------------------------------------------

# ---- Runtime ----
PORT=8080
NODE_ENV=development

# ---- Entra ID (Microsoft) ----
# TODO: supply tenant-specific values from your Entra app registrations.
AUTH_ENTRA_TENANT_ID=
AUTH_ENTRA_UI_CLIENT_ID=
AUTH_ENTRA_API_CLIENT_ID=
AUTH_ENTRA_API_APP_ID_URI=

# ---- App JWT signing (for OTP-authenticated external users) ----
# TODO: supply a strong random HMAC key (>= 32 bytes). Do NOT commit.
AUTH_JWT_SIGNING_KEY=

# ---- OTP email delivery (Azure Communication Services preferred) ----
# TODO: supply from the ACS Email resource. Do NOT commit.
AUTH_ACS_CONNECTION_STRING=
AUTH_ACS_SENDER_ADDRESS=

# DEV/DEMO ONLY — accept OTP "000000" for any email when set to "1".
AUTH_OTP_DEV_BYPASS=1
# DEV/DEMO ONLY — accept unauthenticated requests when set to "1".
AUTH_ALLOW_ANONYMOUS=0

# ---- Persistence (Cosmos DB SQL API). Leave empty to use local file store. ----
PERSIST_COSMOS_ENDPOINT=
PERSIST_COSMOS_DATABASE=agentic_sdlc
# Prefer Managed Identity: leave connection string empty and set endpoint above.
PERSIST_COSMOS_CONNECTION_STRING=

# ---- APIM gateway in front of Foundry ----
# TODO: supply the APIM subscription key OR use managed identity mode.
APIM_SUBSCRIPTION_KEY=
# When "1", the backend is allowed to call Foundry directly (LOCAL DEV ONLY).
FOUNDRY_ALLOW_DIRECT=0

# ---- Source control / work items (PATs) ----
# Leave empty to keep integrations in mock mode. Never commit real tokens.
# TODO: Azure DevOps PAT (Work Items Read & Write) for https://dev.azure.com/csdmichael
ADO_PAT=
# TODO: GitHub PAT (repo scope) for https://github.com/csdmichael
GITHUB_PAT=
